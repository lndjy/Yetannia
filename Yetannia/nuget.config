<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Points NuGet at the local HTTP proxy started by ../../.tools/nuget-proxy.js instead of
    https://api.nuget.org. The harness sandbox blocks Windows schannel, so plain HTTP is the
    only transport available to dotnet in this environment.
  -->
  <packageSources>
    <clear />
    <add key="localproxy" value="http://127.0.0.1:8899/v3/index.json" protocolVersion="3" allowInsecureConnections="true" />
  </packageSources>
</configuration>

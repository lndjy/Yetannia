; Children live under Visuals so the factory can re-parent the whole subtree; the
; AnimationPlayer is a sibling of the Sprite2D it drives, so its track path is
; relative to Visuals (exactly as in creature_visuals/yetannia.tscn).
[node name="Visuals" type="Node2D" parent="."]

[node name="AnimationPlayer" type="AnimationPlayer" parent="Visuals"]
libraries = {
"": SubResource("AnimationLibrary_yetannia_alt")
}
autoplay = "idle"
playback_default_blend_time = 0.0

[node name="Sprite2D" type="Sprite2D" parent="Visuals"]
texture = SubResource("AtlasTexture_0")
position = Vector2(-186.4506, -403.5928)
scale = Vector2(1.2534, 1.2534)
centered = false

; MANDATORY (NRestSiteCharacterFactory): a direct child Control named
; "ControlRoot" and a Control named "Hitbox" anywhere below it. The factory sets
; unique_name_in_owner itself, and generates %SelectionReticle / %ThoughtBubble*
; from the Hitbox rect, so those are deliberately not authored here.
[node name="ControlRoot" type="Control" parent="."]
layout_mode = 3
anchors_preset = 0
mouse_filter = 2

[node name="Hitbox" type="Control" parent="ControlRoot"]
unique_name_in_owner = true
layout_mode = 0
offset_left = -119.1735
offset_top = -312.4623
offset_right = 212.5348

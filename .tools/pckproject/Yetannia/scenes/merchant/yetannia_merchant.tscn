[node name="YetanniaMerchant" type="Node2D"]
; scale deliberately 1: the factory keeps this root as child #0 of the generated
; NMerchantCharacter AFTER copying this root's Scale onto it, so a scale here is
; applied twice (measured 2.01 x 2.01). The character scale is on Visuals below,
; which is also what vanilla's merchant scenes do (root Node2D scale 1, visual
; child 0.47). The rest-site scene keeps its scale HERE, because that factory
; discards the source root instead of keeping it.

; Children live under Visuals so the factory can re-parent the whole subtree; the
; AnimationPlayer is a sibling of the Sprite2D it drives, so its track path is
; relative to Visuals (exactly as in creature_visuals/yetannia.tscn).
[node name="Visuals" type="Node2D" parent="."]
scale = Vector2(2.01, 2.01)

[node name="AnimationPlayer" type="AnimationPlayer" parent="Visuals"]
libraries = {
"": SubResource("AnimationLibrary_yetannia_alt")
}
autoplay = "idle"
playback_default_blend_time = 0.0


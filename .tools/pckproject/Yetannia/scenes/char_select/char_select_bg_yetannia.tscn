[gd_scene load_steps=2 format=3]

; Character-select backdrop for Yetannia.
;
; Structure copied from the vanilla scenes at res://scenes/screens/char_select/char_select_bg_*.tscn,
; which are the only thing this file has to agree with. Measured from
; char_select_bg_ironclad.tscn / _silent.tscn / _regent.tscn:
;
;   root  Control, anchors_preset 8 (centre), anchor_* = 0.5,
;         offset_left = -960, offset_top = -521, offset_right = 1600, offset_bottom = 679
;         pivot_offset = (1280, 600)                     -> a 2560 x 1200 rect
;   Art   TextureRect, layout_mode = 0 (plain position/size), NO anchors,
;         offset_left = -437, offset_top = -107, offset_right = 2197, offset_bottom = 1129
;                                                        -> 2634 x 1236, i.e. a 2.9 % overscan
;         expand_mode = 2, and NO stretch_mode line      -> the default STRETCH_SCALE (0), so the
;                                                           art is stretched to FILL, never letterboxed
;
; The game instantiates this into the "AnimatedBg" Control of character_select_screen.tscn
; (NCharacterSelectScreen.cs:413 gets that node, :838 instantiates the model's CharacterSelectBg into
; it). AnimatedBg is 2560 x 1200 at (-388,-80) with scale 1.1 about its pivot (1280,600), which is why
; the root here must NOT be full-rect: a full-rect root makes the art's visible window asymmetric and,
; with a portrait, is exactly what produced the black bars the user reported.
;
; On a 1920x1080 screen these numbers put the visible window at art columns 570..2266 and rows
; 151..1104 of 2560x1200 -- verified by rendering the chain in
; .tools/out/charselect/bg_preview.py, which parses THIS file's numbers.
;
; The art is generated by .tools/build-select-bg.py (2560 x 1200, full bleed), matching vanilla's
; own backdrop size of 2561 x 1201 -- a wide painting, not a portrait. Do not hand-edit.

[ext_resource type="Texture2D" path="res://Yetannia/images/charui/char_select_yetannia_bg.png" id="1"]

[node name="YetanniaSelectBg" type="Control"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -960.0
offset_top = -521.0
offset_right = 1600.0
offset_bottom = 679.0
grow_horizontal = 2
grow_vertical = 2
pivot_offset = Vector2(1280, 600)
mouse_filter = 2

[node name="Art" type="TextureRect" parent="."]
layout_mode = 0
offset_left = -437.0
offset_top = -107.0
offset_right = 2197.0
offset_bottom = 1129.0
mouse_filter = 2
texture = ExtResource("1")
expand_mode = 2
stretch_mode = 0
